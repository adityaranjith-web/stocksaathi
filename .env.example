# Leave both empty to run in demo mode with the Session 6 sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI forecasts (optional, server only). Never use a NEXT_PUBLIC_ name for these. See docs/ai-integration.md.
# AI_MODE=shadow            # off (default) | shadow | blend
# AI_FORECASTER=mock        # mock (practice model) | http
# AI_FORECAST_URL=          # for http: https address of your AI service
# AI_FORECAST_KEY=          # for http: secret sent as a Bearer token
